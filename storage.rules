rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isEditor() {
      return isSignedIn() && request.auth.token.role in ['owner', 'editor'];
    }

    // Public read for media under /public/
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor()
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 5 * 1024 * 1024) ||
          (request.resource.contentType == 'application/pdf' && request.resource.size <= 10 * 1024 * 1024)
        );
    }
  }
}
